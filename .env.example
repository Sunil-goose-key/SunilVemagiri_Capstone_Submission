# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5

# Added beyond the pack's original template, both empirically justified (see
# docs/architecture.md and src/config.py comments) rather than left as unexamined defaults:
# - RETRIEVAL_RELEVANCE_FLOOR: calibrated against real irrelevant-vs-relevant query scores
#   from the built vector store (irrelevant ~ -0.35 to -0.40, relevant ~ 0.09 to 0.61).
# - AUTO_RESPOND_ENABLED: the governance kill switch (Governance_Framework_DRAFT.md).
RETRIEVAL_RELEVANCE_FLOOR=0.05
AUTO_RESPOND_ENABLED=true
